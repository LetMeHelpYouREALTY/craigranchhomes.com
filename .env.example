# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.craigranchhomes.com

# Cloudflare Images (hosted)
# Delivery: https://imagedelivery.net/byE6BTe9lNqo21V57n4aPQ/<image_id>/public
# Account hash is public. API token is required only to upload.
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=byE6BTe9lNqo21V57n4aPQ
# Production enables hosted Images automatically. Set true for local, false to force git copies.
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=true
# Custom Images host on the same Cloudflare account (orange-cloud this host only).
# www.craigranchhomes.com stays DNS-only / Vercel.
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_CUSTOM_HOST=images.craigranchhomes.com
# CLOUDFLARE_API_TOKEN=
