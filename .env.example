# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://heyberkshire.com

# Google Search Console
# Add the property in https://search.google.com/search-console, choose the
# "HTML tag" verification method, and paste only the content="..." value below
# (not the full <meta> tag). Leave unset to skip rendering the verification tag.
GOOGLE_SITE_VERIFICATION=
