# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://www.craigranchhomes.com

# Google Maps Platform — Maps JavaScript API, Places API (New), and Directions.
# HTTP referrers must include https://www.craigranchhomes.com/* and
# https://craigranchhomes.com/* or the interactive maps fall back to embeds.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for Advanced Markers styling (amenity map works without it)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
