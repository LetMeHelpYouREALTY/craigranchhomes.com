# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://www.craigranchhomes.com

# Optional Maps JavaScript key. The current key rejects this site's referrer,
# so directions, address lookup, and the amenity map use keyless Google embeds.
# Address suggestions come from OpenStreetMap Nominatim on the server.
# To turn Maps JavaScript back on, allow these HTTP referrers:
# https://www.craigranchhomes.com/* and https://craigranchhomes.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for Advanced Markers styling (amenity map works without it)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
